n_widths><column index="1" value="55"/><column index="2" value="68"/><column index="3" value="124"/><column index="4" value="124"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="tblUsers" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="47"/><column index="2" value="65"/><column index="3" value="70"/><column index="4" value="202"/><column index="5" value="300"/><column index="6" value="156"/><column index="7" value="115"/><column index="8" value="85"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1"></sql><sql name="&amp;Foreign-Key Check*">PRAGMA foreign_key_check;

DELETE FROM tblEnrollments
WHERE CourseID IS NOT NULL
  AND NOT EXISTS (
    SELECT 1 FROM tblCourses WHERE CourseID = tblEnrollments.CourseID
  );

-- Step 1: Delete from groupMembers where GroupID = 8
DELETE FROM tblGroupMembers
WHERE GroupID = 8;

-- Step 2: Now, delete the orphaned row from tblCourseGroups
DELETE FROM tblCourseGroups
WHERE GroupID = 8
  AND NOT EXISTS (
    SELECT 1 FROM tblCourses WHERE CourseID = tblCourseGroups.CourseID
  );
</sql><current_tab id="1"/></tab_sql></sqlb_project>
